# Reserved configuration names. NOT USED in the Foundation stage; nothing here is required to
# lint, test or build. Each module validates the values it needs when that module is implemented.
# The exact Meta/WhatsApp variable contract is finalized in the WhatsApp integration phase.

# Database: standard PostgreSQL connection string (placeholders only; never commit real values).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Optional direct (non-pooled) connection used only by `npm run db:migrate`; falls back to DATABASE_URL.
# DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Authentication (Better Auth). Read and validated only when an auth instance is first used; the app builds
# and tests without them. Generate the secret with e.g. `openssl rand -base64 48`. Placeholders only.
# BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# BETTER_AUTH_URL=https://app.example.com
# One-shot, ONLY for non-interactive runs of `npm run auth:bootstrap-admin` (normally the command prompts for the
# password with no echo). Never commit a real value; unset it after the run.
# BOOTSTRAP_ADMIN_PASSWORD=

# WhatsApp / Meta webhook (Phase 04). Read and validated only when the webhook endpoint is used; the app builds and
# tests without them. Placeholders only; never commit real values.
# META_APP_SECRET is the Meta app's App Secret (signs every webhook delivery); at least 16 characters.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN is a random string you choose and also enter in Meta's webhook settings; at least 32 characters.
# META_APP_SECRET=replace-with-the-meta-app-secret
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-at-least-32-random-characters
# (Access tokens for sending messages are not used yet and are not read.)

# Standalone webhook worker (`npm run whatsapp:worker`). DISABLED unless this is exactly "true"; it reads DATABASE_URL, needs
# the migrated schema, and never calls Meta. Optional limits: batch size 1-100 (default 20), concurrency 1-8 (default 2).
# WHATSAPP_WORKER_ENABLED=false
# WHATSAPP_WORKER_BATCH_SIZE=20
# WHATSAPP_WORKER_CONCURRENCY=2

# Lead reconciler (`npm run leads:reconcile`): ONE bounded pass that links confirmed Meta ad referrals to open leads or creates
# leads from them. DISABLED unless this is exactly "true"; it reads DATABASE_URL, needs migration 0006, never calls Meta and is
# never started by anything else (no scheduler exists). Optional limits: freshness window 1-90 days (default 14), touches
# processed per run 1-1000 (default 100), run time 1-600 seconds (default 30), candidate rows read per run 1-100000 (default 5000).
# LEADS_RECONCILER_ENABLED=false
# LEADS_RECONCILE_FRESHNESS_DAYS=14
# LEADS_RECONCILE_BATCH_SIZE=100
# LEADS_RECONCILE_MAX_SECONDS=30
# LEADS_RECONCILE_SCAN_LIMIT=5000
# Every statement of the reconciler is also bounded by PostgreSQL itself (per transaction): table-lock wait 1-60 s (default 3), statement 1-120 s (default 20).
# LEADS_RECONCILE_LOCK_TIMEOUT_SECONDS=3
# LEADS_RECONCILE_STATEMENT_TIMEOUT_SECONDS=20

# Operator payload reveal (`npm run whatsapp:events -- dead inspect <id> --reveal-payload`). DISABLED unless this is exactly "true".
# WARNING: revealing prints stored webhook payloads (message text, phone numbers, names, BSUIDs). This variable is only a
# defense-in-depth switch: it is NOT authentication, NOT authorization and NOT an audit trail. Payload reveal stays UNAPPROVED
# FOR REAL CUSTOMER DATA until a trusted operator identity, restricted execution permissions, durable audit logs and
# authorization to read personal data exist (docs/RUNBOOK_WHATSAPP.md). Never set it in a shared or production environment.
# WHATSAPP_ALLOW_PII_REVEAL=false

# WhatsApp / Meta (remaining names to be finalized in later phases)

# Outbound WhatsApp messaging (Phase 05). EVERYTHING IS OFF unless a variable is exactly "true". Nothing in the web app, the build,
# a migration or a test sends a message; only `npm run whatsapp:outbound-worker` can, and only with BOTH of the first two gates.
# WHATSAPP_OUTBOUND_ENABLED: staff may queue outbound requests (the API refuses otherwise) and the outbound worker may start.
# WHATSAPP_LIVE_SEND_ENABLED: the transport may make a real HTTP request to Meta (checked again at the HTTP call, every time).
# WHATSAPP_BSUID_RECIPIENT_ENABLED: send to a BSUID through the `recipient` field. Meta marks that API "coming soon"; leave it off
#   until a live test proves it (docs/WHATSAPP_OUTBOUND_EVIDENCE.md).
# WHATSAPP_GRAPH_API_VERSION: the Graph API version (for example v25.0); deliberately has no default.
# Each account's access token is read from the environment variable NAMED by that account's credential_ref (for example
# WHATSAPP_TOKEN_ALPHA=...). The token is never stored in the database, logged or put in a URL. Never commit a real value.
# WHATSAPP_OUTBOUND_ENABLED=false
# WHATSAPP_LIVE_SEND_ENABLED=false
# WHATSAPP_BSUID_RECIPIENT_ENABLED=false
# WHATSAPP_GRAPH_API_VERSION=v25.0
# WHATSAPP_OUTBOUND_BATCH_SIZE=10
# WHATSAPP_OUTBOUND_CONCURRENCY=2
# Bot automation (Phases 08D-08E; docs/adr/0021-bot-runtime.md). NOT AUTHORIZED FOR ACTIVATION: keep every gate off. Three
# separate processes read their OWN environment, so the same variable can be on in one process and off in another:
#   - webhook worker (`npm run whatsapp:worker`, starts only with WHATSAPP_WORKER_ENABLED=true): with BOTS_RUNTIME_ENABLED=true
#     in ITS environment it also records a bot trigger for each inbound text, button or list reply where a bot deployment is
#     active (or a bot session is live). Off, the inbound path is exactly as before (no trigger is written).
#   - bot worker (`npm run bots:worker`): starts only when BOTS_RUNTIME_ENABLED and WHATSAPP_OUTBOUND_ENABLED are both "true";
#     it then needs DATABASE_URL and PostgreSQL 17 or later. It starts sessions and queues bot messages; it never calls Meta and
#     reads no token. BOTS_WORKER_CONCURRENCY: parallel trigger lanes (default 4, allowed 1-16).
#   - outbound worker (`npm run whatsapp:outbound-worker`): sends only with WHATSAPP_OUTBOUND_ENABLED and
#     WHATSAPP_LIVE_SEND_ENABLED; it claims bot (origin BOT) requests only when ITS BOTS_RUNTIME_ENABLED is also "true".
#     Off, bot requests stay queued (they cannot starve staff messages); a running bot worker holds any that miss the 120 s
#     dispatch deadline and hands the session to staff.
# A bot message reaches Meta only when all three gates are on in the outbound worker. Nothing in the web app, the build or a
# migration starts either worker (only the npm scripts above, and isolated tests against disposable databases).
# BOTS_RUNTIME_ENABLED=false
# BOTS_WORKER_CONCURRENCY=4

# Staff inbox (Phase 06) polling. Optional; invalid or out-of-range values fall back to the defaults, so a typo cannot cause a request storm.
# INBOX_POLL_LIST_MS: how often the conversation list refreshes while the tab is visible (default 15000, allowed 3000-300000).
# INBOX_POLL_CHAT_MS: how often the open conversation refreshes while visible (default 5000, allowed 2000-120000).
# A hidden tab polls at one tenth of the rate. See docs/adr/0015-staff-inbox.md.
# INBOX_POLL_LIST_MS=15000
# INBOX_POLL_CHAT_MS=5000
