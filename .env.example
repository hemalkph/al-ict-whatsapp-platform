# Reserved configuration names. NOT USED in the Foundation stage; nothing here is required to
# lint, test or build. Each module validates the values it needs when that module is implemented.
# The exact Meta/WhatsApp variable contract is finalized in the WhatsApp integration phase.

# Database: standard PostgreSQL connection string (placeholders only; never commit real values).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Optional direct (non-pooled) connection used only by `npm run db:migrate`; falls back to DATABASE_URL.
# DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Authentication (Better Auth). Read and validated only when an auth instance is first used; the app builds
# and tests without them. Generate the secret with e.g. `openssl rand -base64 48`. Placeholders only.
# BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# BETTER_AUTH_URL=https://app.example.com
# One-shot, ONLY for non-interactive runs of `npm run auth:bootstrap-admin` (normally the command prompts for the
# password with no echo). Never commit a real value; unset it after the run.
# BOOTSTRAP_ADMIN_PASSWORD=

# WhatsApp / Meta webhook (Phase 04). Read and validated only when the webhook endpoint is used; the app builds and
# tests without them. Placeholders only; never commit real values.
# META_APP_SECRET is the Meta app's App Secret (signs every webhook delivery); at least 16 characters.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN is a random string you choose and also enter in Meta's webhook settings; at least 32 characters.
# META_APP_SECRET=replace-with-the-meta-app-secret
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-at-least-32-random-characters
# (Access tokens for sending messages are not used yet and are not read.)

# Standalone webhook worker (`npm run whatsapp:worker`). DISABLED unless this is exactly "true"; it reads DATABASE_URL, needs
# the migrated schema, and never calls Meta. Optional limits: batch size 1-100 (default 20), concurrency 1-8 (default 2).
# WHATSAPP_WORKER_ENABLED=false
# WHATSAPP_WORKER_BATCH_SIZE=20
# WHATSAPP_WORKER_CONCURRENCY=2

# WhatsApp / Meta (remaining names to be finalized in later phases)
